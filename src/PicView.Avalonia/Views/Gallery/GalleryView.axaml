<customControls:GalleryAnimationControl
    x:Class="PicView.Avalonia.Views.Gallery.GalleryView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customControls="clr-namespace:PicView.Avalonia.CustomControls"
    xmlns:gallery="clr-namespace:PicView.Avalonia.Views.Gallery"
    xmlns:gallerySettings="clr-namespace:PicView.Core.Gallery;assembly=PicView.Core"
    xmlns:viewModels="clr-namespace:PicView.Core.ViewModels;assembly=PicView.Core"
    x:DataType="viewModels:TabViewModel"
    ActiveGalleryMode="{CompiledBinding Gallery.ActiveGalleryMode.Value}"
    Background="{DynamicResource GalleryBackgroundColor}"
    BorderBrush="{DynamicResource GalleryBorderColor}">
    <customControls:GalleryAnimationControl.Styles>
        <Style Selector="customControls|NavigateAbleItem.galleryItem">
            <Setter Property="Width" Value="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).GallerySettings.ItemWidth.Value, Mode=OneWay}" />
            <Setter Property="Height" Value="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).GallerySettings.ItemHeight.Value, Mode=OneWay}" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Background" Value="{DynamicResource GalleryItemBackgroundColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GalleryItemBorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="customControls|NavigateAbleItem.galleryItem Panel.thumbPanel">
            <Setter Property="Margin" Value="1" />
        </Style>
        <Style Selector="customControls|NavigateAbleItem.galleryItem Border.selectionRing">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!--  Masonry and rows: the panel sizes the items, which are rounded and borderless, and fade in when loaded  -->
        <Style Selector="gallery|GalleryView.flowLayout customControls|NavigateAbleItem.galleryItem">
            <Setter Property="Width" Value="NaN" />
            <Setter Property="Height" Value="NaN" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="gallery|GalleryView.flowLayout customControls|NavigateAbleItem.galleryItem /template/ Border#border">
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="gallery|GalleryView.flowLayout customControls|NavigateAbleItem.galleryItem Panel.thumbPanel">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="gallery|GalleryView.flowLayout customControls|NavigateAbleItem.galleryItem Border.selectionRing">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="gallery|GalleryView.flowLayout customControls|NavigateAbleItem.galleryItem:selectedItem Border.selectionRing">
            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryAccentColor}" />
        </Style>
        <Style Selector="gallery|GalleryView.flowLayout customControls|NavigateAbleItem.galleryItem:contextMenuOpen Border.selectionRing">
            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryAccentColor}" />
        </Style>
        <Style Selector="gallery|GalleryView.flowLayout customControls|NavigateAbleItem.galleryItem:currentItem Border.selectionRing">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
        </Style>
        <Style Selector="gallery|GalleryView.flowLayout customControls|NavigateAbleItem.galleryItem customControls|ThumbImage">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="scale(1.04)" />
        </Style>
        <Style Selector="gallery|GalleryView.flowLayout customControls|NavigateAbleItem.galleryItem customControls|ThumbImage.fadeIn">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition
                        Easing="CubicEaseOut"
                        Property="Opacity"
                        Duration="0:0:0.32" />
                    <TransformOperationsTransition
                        Easing="CubicEaseOut"
                        Property="RenderTransform"
                        Duration="0:0:0.36" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="gallery|GalleryView.flowLayout customControls|NavigateAbleItem.galleryItem customControls|ThumbImage.loaded">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>
    </customControls:GalleryAnimationControl.Styles>
    <Panel>

        <Panel.ContextMenu>
            <ContextMenu>
                <customControls:StyledMenuItem Header="{Binding ParentWindowContext.Translation.GalleryLayout.Value, Mode=OneWay}" IsVisible="{CompiledBinding Gallery.IsGalleryExpanded.Value}">
                    <MenuItem.Icon>
                        <Path
                            Width="12"
                            Height="12"
                            Data="{StaticResource GalleryGeometry}"
                            Fill="{DynamicResource MainTextColor}"
                            Stretch="Fill" />
                    </MenuItem.Icon>
                    <customControls:StyledMenuItem
                        Command="{Binding ParentWindowContext.GallerySettings.SetExpandedLayoutCommand}"
                        CommandParameter="{x:Static gallerySettings:GalleryLayout.Masonry}"
                        Header="{Binding ParentWindowContext.Translation.Masonry.Value, Mode=OneWay}"
                        IsChecked="{Binding ParentWindowContext.GallerySettings.IsExpandedLayoutMasonry.Value}"
                        ToggleType="Radio" />
                    <customControls:StyledMenuItem
                        Command="{Binding ParentWindowContext.GallerySettings.SetExpandedLayoutCommand}"
                        CommandParameter="{x:Static gallerySettings:GalleryLayout.Rows}"
                        Header="{Binding ParentWindowContext.Translation.Rows.Value, Mode=OneWay}"
                        IsChecked="{Binding ParentWindowContext.GallerySettings.IsExpandedLayoutRows.Value}"
                        ToggleType="Radio" />
                    <customControls:StyledMenuItem
                        Command="{Binding ParentWindowContext.GallerySettings.SetExpandedLayoutCommand}"
                        CommandParameter="{x:Static gallerySettings:GalleryLayout.Columns}"
                        Header="{Binding ParentWindowContext.Translation.Columns.Value, Mode=OneWay}"
                        IsChecked="{Binding ParentWindowContext.GallerySettings.IsExpandedLayoutColumns.Value}"
                        ToggleType="Radio" />
                </customControls:StyledMenuItem>
                <!--  The thumbnails of the masonry and row layouts always fill their aspect ratio  -->
                <customControls:StyledMenuItem Header="{Binding ParentWindowContext.Translation.Stretch.Value, Mode=OneWay}">
                    <customControls:StyledMenuItem.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="Gallery.IsGalleryExpanded.Value" />
                            <Binding Path="ParentWindowContext.GallerySettings.IsExpandedLayoutColumns.Value" />
                        </MultiBinding>
                    </customControls:StyledMenuItem.IsVisible>
                    <MenuItem.Icon>
                        <Image Classes="SquareDimensionsImage" />
                    </MenuItem.Icon>
                    <customControls:StyledMenuItem
                        Command="{Binding ParentWindowContext.GallerySettings.SetExpandedStretchModeCommand}"
                        CommandParameter="{x:Static gallerySettings:GalleryStretchMode.Uniform}"
                        Header="{Binding ParentWindowContext.Translation.Uniform.Value, Mode=OneWay}"
                        IsChecked="{Binding ParentWindowContext.GallerySettings.IsExpandedStretchUniform.Value}"
                        ToggleType="Radio" />
                    <customControls:StyledMenuItem
                        Command="{Binding ParentWindowContext.GallerySettings.SetExpandedStretchModeCommand}"
                        CommandParameter="{x:Static gallerySettings:GalleryStretchMode.UniformToFill}"
                        Header="{Binding ParentWindowContext.Translation.UniformToFill.Value, Mode=OneWay}"
                        IsChecked="{Binding ParentWindowContext.GallerySettings.IsExpandedStretchUniformToFill.Value}"
                        ToggleType="Radio" />
                    <customControls:StyledMenuItem
                        Command="{Binding ParentWindowContext.GallerySettings.SetExpandedStretchModeCommand}"
                        CommandParameter="{x:Static gallerySettings:GalleryStretchMode.Square}"
                        Header="{Binding ParentWindowContext.Translation.Square.Value, Mode=OneWay}"
                        IsChecked="{Binding ParentWindowContext.GallerySettings.IsExpandedStretchSquare.Value}"
                        ToggleType="Radio" />
                    <customControls:StyledMenuItem
                        Command="{Binding ParentWindowContext.GallerySettings.SetExpandedStretchModeCommand}"
                        CommandParameter="{x:Static gallerySettings:GalleryStretchMode.FillSquare}"
                        Header="{Binding ParentWindowContext.Translation.FillSquare.Value, Mode=OneWay}"
                        IsChecked="{Binding ParentWindowContext.GallerySettings.IsExpandedStretchSquareFill.Value}"
                        ToggleType="Radio" />
                </customControls:StyledMenuItem>
                <customControls:StyledMenuItem Header="{Binding ParentWindowContext.Translation.Stretch.Value, Mode=OneWay}" IsVisible="{CompiledBinding !Gallery.IsGalleryExpanded.Value}">
                    <MenuItem.Icon>
                        <Image Classes="SquareDimensionsImage" />
                    </MenuItem.Icon>
                    <customControls:StyledMenuItem
                        Command="{Binding ParentWindowContext.GallerySettings.SetDockedStretchModeCommand}"
                        CommandParameter="{x:Static gallerySettings:GalleryStretchMode.Uniform}"
                        Header="{Binding ParentWindowContext.Translation.Uniform.Value, Mode=OneWay}"
                        IsChecked="{Binding ParentWindowContext.GallerySettings.IsDockedStretchUniform.Value}"
                        ToggleType="Radio" />
                    <customControls:StyledMenuItem
                        Command="{Binding ParentWindowContext.GallerySettings.SetDockedStretchModeCommand}"
                        CommandParameter="{x:Static gallerySettings:GalleryStretchMode.UniformToFill}"
                        Header="{Binding ParentWindowContext.Translation.UniformToFill.Value, Mode=OneWay}"
                        IsChecked="{Binding ParentWindowContext.GallerySettings.IsDockedStretchUniformToFill.Value}"
                        ToggleType="Radio" />
                    <customControls:StyledMenuItem
                        Command="{Binding ParentWindowContext.GallerySettings.SetDockedStretchModeCommand}"
                        CommandParameter="{x:Static gallerySettings:GalleryStretchMode.Square}"
                        Header="{Binding ParentWindowContext.Translation.Square.Value, Mode=OneWay}"
                        IsChecked="{Binding ParentWindowContext.GallerySettings.IsDockedStretchSquare.Value}"
                        ToggleType="Radio" />
                    <customControls:StyledMenuItem
                        Command="{Binding ParentWindowContext.GallerySettings.SetDockedStretchModeCommand}"
                        CommandParameter="{x:Static gallerySettings:GalleryStretchMode.FillSquare}"
                        Header="{Binding ParentWindowContext.Translation.FillSquare.Value, Mode=OneWay}"
                        IsChecked="{Binding ParentWindowContext.GallerySettings.IsDockedStretchSquareFill.Value}"
                        ToggleType="Radio" />
                </customControls:StyledMenuItem>
                <customControls:StyledMenuItem Header="{CompiledBinding $parent[Window].((viewModels:MainWindowViewModel)DataContext).Translation.ExpandedGalleryItemSize.Value, Mode=OneWay}" PointerPressed="ShowGalleryItemSizeSlider">
                    <MenuItem.Icon>
                        <Image Classes="ScalingImage" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>
                <Separator />
                <customControls:StyledMenuItem Command="{Binding Gallery.ToggleGalleryCommand}" Header="{CompiledBinding ParentWindowContext.Translation.ShowImageGallery.Value, Mode=OneWay}">
                    <MenuItem.Icon>
                        <Path
                            Width="12"
                            Height="12"
                            Data="{StaticResource GalleryGeometry}"
                            Fill="{DynamicResource MainTextColor}"
                            Stretch="Fill" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>
                <customControls:StyledMenuItem
                    Command="{Binding Gallery.ContractToDockedOrCloseGalleryCommand}"
                    Header="{CompiledBinding ParentWindowContext.Translation.HideDockedGallery.Value,
                                             Mode=OneWay}"
                    IsVisible="{CompiledBinding !Gallery.IsGalleryExpanded.Value}">
                    <MenuItem.Icon>
                        <Path
                            Width="12"
                            Height="12"
                            Data="{StaticResource CloseGeometry}"
                            Fill="{DynamicResource MainTextColor}"
                            Stretch="Fill" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>
                <customControls:StyledMenuItem
                    Command="{Binding Gallery.ContractToDockedOrCloseGalleryCommand}"
                    Header="{CompiledBinding ParentWindowContext.Translation.CloseGallery.Value,
                                             Mode=OneWay}"
                    IsVisible="{CompiledBinding Gallery.IsGalleryExpanded.Value}">
                    <MenuItem.Icon>
                        <Path
                            Width="12"
                            Height="12"
                            Data="{StaticResource CloseGeometry}"
                            Fill="{DynamicResource MainTextColor}"
                            Stretch="Fill" />
                    </MenuItem.Icon>
                </customControls:StyledMenuItem>
            </ContextMenu>
        </Panel.ContextMenu>

        <Button
            Width="50"
            Height="60"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="{DynamicResource PopUpBackgroundColor}"
            BorderBrush="{DynamicResource MenuBorderColor}"
            BorderThickness="1,0,0,0"
            Classes="hover"
            Command="{CompiledBinding Gallery.ToggleGalleryCommand}"
            CornerRadius="0,0,0,45"
            DockPanel.Dock="Right"
            IsVisible="{CompiledBinding Gallery.IsGalleryExpanded.Value}"
            ZIndex="99">
            <Path
                Width="23"
                Height="23"
                Margin="7,0,0,11"
                Data="{StaticResource CloseGeometry}"
                Fill="{DynamicResource MainTextColor}"
                Stretch="Fill" />
        </Button>

        <customControls:NavigateAbleItemsViewer
            x:Name="GalleryItemsControl"
            CurrentItemIndex="{CompiledBinding NavigationIndex.Value,
                                               Mode=OneWay}"
            SelectedItemIndex="{CompiledBinding Gallery.SelectedGalleryItemIndex.Value,
                                                Mode=TwoWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <gallery:GalleryItem />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <customControls:VirtualizingGallery
                        x:Name="GalleryItemsPanel"
                        VerticalAlignment="Center"
                        ItemHeight="{Binding ParentWindowContext.GallerySettings.ItemHeight.Value}"
                        ItemSpacing="{CompiledBinding Gallery.ItemSpacing.Value}"
                        ItemWidth="{Binding ParentWindowContext.GallerySettings.ItemWidth.Value}"
                        LineSpacing="{CompiledBinding Gallery.LineSpacing.Value}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </customControls:NavigateAbleItemsViewer>

    </Panel>
</customControls:GalleryAnimationControl>